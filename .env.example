# 9Router (TTS + LLM)
NINEROUTER_URL=http://host.docker.internal:20128/v1
NINEROUTER_API_KEY=your_9router_api_key_here
AI_MODEL=cf/@cf/meta/llama-3.3-70b-instruct-fp8-fast

# MEGA
MEGA_EMAIL=your_mega_email@gmail.com
MEGA_PASSWORD=your_mega_password_here
MEGA_BASE=/Root/tiktok-english/Production

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
SUPABASE_TABLE=vibte_videos

# Vocab sources
OXFORD_CSV_URL=https://raw.githubusercontent.com/nalgeon/words/main/data/oxford-5k.csv
DICT_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en/{word}

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/callback

# App auth (SECRET_KEY must be fixed for persistent sessions)
APP_USERNAME=admin
APP_PASSWORD=vibte2024
APP_SECRET_KEY=your_super_secret_key_change_in_prod

VIBTE_WORKROOT=/var/vibte
